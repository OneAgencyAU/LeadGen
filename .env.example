# SA LeadGen — Environment Variables
# Copy this to .env for local development (never commit .env)
# All of these must also be set as Railway environment variables for production.

# Claude / Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Apify (Google Maps scraping)
APIFY_API_KEY=apify_api_...

# Supabase (deduplication + logging)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...  # service role key — NOT the anon key

# Gmail OAuth2 (draft creation)
# Run `npm run setup-gmail` locally to generate the refresh token
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-...
GMAIL_REFRESH_TOKEN=1//...  # generated by scripts/setupGmailAuth.js

# Google Sheets (portfolio data)
# Paste the full service account JSON as a single line
GOOGLE_SHEETS_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
PORTFOLIO_SHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms  # from the Google Sheet URL

# App config
TZ=Australia/Adelaide       # CRITICAL — ensures cron fires at correct Adelaide time
DAILY_LEAD_CAP=20           # Change this single value to scale volume

# Optional
DEBUG=  # Set to "1" to enable verbose logging
